{
	"name": "remindwise-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"build:lambdas": "pnpm -r build:lambdas",
		"preview": "pnpm -r preview",
		"dev": "pnpm -r --parallel dev",
		"lint": "pnpm -r lint",
		"format": "pnpm -r format",
		"format:write": "pnpm -r format:write",
		"test": "pnpm -r test",
		"test:watch": "pnpm -r test:watch",
		"test:a11y": "pnpm -r test:a11y",
		"test:functional": "pnpm -r test:functional",
		"test:visual": "pnpm -r test:visual",
		"test:visual:update": "pnpm -r test:visual:update",
		"types": "pnpm -r types"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@playwright/test": "1.63.0",
		"@testing-library/jest-dom": "6.9.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-playwright": "2.11.0",
		"eslint-plugin-svelte": "2.46.1",
		"globals": "15.15.0",
		"svelte-eslint-parser": "0.43.0",
		"typescript-eslint": "8.69.0"
	},
	"prepare": "svelte-kit sync",
	"packageManager": "pnpm@10.34.5",
	"dependencies": {
		"@supabase/supabase-js": "2.115.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"svelte-preprocess"
		]
	}
}
