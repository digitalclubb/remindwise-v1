{
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --parallel",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"format:write": "prettier --write . '**/*.{css,ts,tsx,js,json,md,svelte}'",
