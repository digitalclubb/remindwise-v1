		"@testing-library/svelte": "3.2.2",
		"@typescript-eslint/eslint-plugin": "5.59.6",
		"@typescript-eslint/parser": "5.59.6",
		"eslint": "8.40.0",
		"eslint-plugin-svelte": "2.28.0",
		"jsdom": "21.1.2",
		"prettier": "2.8.8",
		"prettier-plugin-svelte": "2.10.1",
		"svelte": "3.59.1",
