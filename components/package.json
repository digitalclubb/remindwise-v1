		"@typescript-eslint/parser": "6.19.1",
		"eslint": "8.56.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.35.1",
		"jsdom": "23.2.0",
		"prettier": "3.2.4",
		"prettier-plugin-svelte": "3.1.2",
		"svelte": "4.2.9",
		"svelte-eslint-parser": "0.33.1",
		"svelte-preprocess": "5.1.3",
		"typescript": "5.3.3",
		"vitest": "1.2.1"
