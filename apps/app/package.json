{
	"name": "app",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"build:lambdas": "pnpm run build:notifier && pnpm run build:user-retriever",
		"build:notifier": "esbuild src/lambdas/notifier/index.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=../../dist/notifier/index.js",
		"build:user-retriever": "esbuild src/lambdas/user-retriever/index.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=../../dist/user-retriever/index.js",
		"package": "vite package",
		"prepare": "svelte-kit sync",
		"preview": "vite preview --port 4174",
		"houdini:sync": "houdini generate -p",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../eslint.config.mjs --max-warnings 0",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"graphql:codegen": "pnpm sync && graphql-codegen --require dotenv/config",
		"test": "vitest run",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional",
		"test:visual": "playwright test --grep @visual",
		"test:visual:update": "playwright test --grep @visual --update-snapshots"
	},
	"dependencies": {
		"@aptabase/web": "0.5.0",
		"@aws-sdk/client-dynamodb": "3.1127.0",
		"@aws-sdk/client-ses": "3.1127.0",
		"@aws-sdk/lib-dynamodb": "3.1127.0",
		"@date-fns/utc": "2.1.1",
		"@sentry/sveltekit": "9.47.1",
		"@supabase/ssr": "0.12.6",
		"@supabase/supabase-js": "2.115.0",
		"@sveltejs/adapter-vercel": "5.10.3",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "5.1.1",
		"d3-format": "3.1.2",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"date-fns": "4.4.0",
		"houdini": "1.5.10",
		"houdini-svelte": "2.1.20",
		"layercake": "8.4.4",
		"svelte": "5.57.0",
		"svelte-preprocess": "6.0.5",
		"sveltekit-superforms": "2.30.2",
		"vite": "6.4.3",
		"vite-plugin-graphql-loader": "4.0.4",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@graphql-codegen/cli": "5.0.7",
		"@graphql-codegen/typed-document-node": "5.1.2",
		"@graphql-codegen/typescript": "4.1.6",
		"@graphql-codegen/typescript-operations": "4.6.1",
		"@graphql-typed-document-node/core": "3.2.0",
		"@playwright/test": "1.63.0",
		"@testing-library/svelte": "5.4.2",
		"@types/aws-lambda": "8.10.163",
		"@types/d3-format": "3.0.4",
		"@types/d3-scale": "4.0.9",
		"@types/d3-shape": "3.2.0",
		"@types/node": "22.20.1",
		"@typescript-eslint/eslint-plugin": "8.69.0",
		"@typescript-eslint/parser": "8.69.0",
		"dotenv": "16.6.1",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "2.46.1",
		"jsdom": "^26.0.0",
		"msw": "2.15.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "3.5.2",
		"svelte-check": "4.7.6",
		"svelte-eslint-parser": "0.43.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.69.0",
		"vitest": "3.2.7"
	},
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
