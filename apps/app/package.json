{
	"name": "app",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"package": "vite package",
		"preview": "vite preview --port 4174",
		"sync": "svelte-kit sync",
		"houdini:sync": "houdini generate -p",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../eslint.config.mjs",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"graphql:codegen": "pnpm sync && graphql-codegen --require dotenv/config",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional"
	},
	"dependencies": {
		"@supabase/ssr": "0.3.0",
		"@supabase/supabase-js": "2.43.1",
		"@sveltejs/adapter-vercel": "5.3.0",
		"@sveltejs/kit": "2.5.7",
		"@sveltejs/vite-plugin-svelte": "3.1.0",
		"@vercel/analytics": "1.2.2",
		"components": "workspace:*",
		"d3-format": "3.1.0",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"houdini": "1.2.47",
		"houdini-svelte": "1.2.47",
		"layercake": "8.1.2",
		"svelte": "4.2.15",
		"svelte-preprocess": "5.1.4",
		"sveltekit-superforms": "2.13.0",
		"vite": "5.2.11",
		"vite-plugin-graphql-loader": "3.0.1",
		"zod": "3.23.6"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.9.0",
		"@graphql-codegen/cli": "5.0.2",
		"@graphql-codegen/typed-document-node": "5.0.6",
		"@graphql-codegen/typescript": "4.0.6",
		"@graphql-codegen/typescript-operations": "4.2.0",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@playwright/test": "1.43.1",
		"@testing-library/svelte": "4.2.3",
		"@types/d3-format": "3.0.4",
		"@types/d3-scale": "4.0.8",
		"@types/d3-shape": "3.1.6",
		"@typescript-eslint/eslint-plugin": "7.8.0",
		"@typescript-eslint/parser": "7.8.0",
		"eslint": "9.2.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.38.0",
		"playwright-core": "1.43.1",
		"prettier": "3.2.5",
		"prettier-plugin-svelte": "3.2.3",
		"svelte-check": "3.7.1",
		"svelte-eslint-parser": "0.35.0",
		"typescript": "5.4.5",
		"typescript-eslint": "7.8.0"
	},
	"type": "module",
	"packageManager": "pnpm@9.0.6"
}
