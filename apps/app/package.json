{
	"name": "app",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"package": "vite package",
		"preview": "vite preview --port 4174",
		"sync": "svelte-kit sync",
		"houdini:sync": "houdini generate -p",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../.eslintrc.js 'src'",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"graphql:codegen": "pnpm sync && graphql-codegen --require dotenv/config",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional"
	},
	"dependencies": {
		"@supabase/auth-helpers-sveltekit": "0.12.0",
		"@supabase/supabase-js": "2.41.1",
		"@sveltejs/adapter-vercel": "5.2.0",
		"@sveltejs/kit": "2.5.5",
		"@sveltejs/vite-plugin-svelte": "3.0.2",
		"@vercel/analytics": "1.2.2",
		"components": "workspace:*",
		"d3-format": "3.1.0",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"houdini": "1.2.46",
		"houdini-svelte": "1.2.46",
		"layercake": "8.1.1",
		"svelte": "4.2.12",
		"svelte-preprocess": "5.1.3",
		"sveltekit-superforms": "1.13.4",
		"vite": "5.2.7",
		"vite-plugin-graphql-loader": "3.0.1",
		"zod": "3.22.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.8.5",
		"@graphql-codegen/cli": "5.0.2",
		"@graphql-codegen/typed-document-node": "5.0.6",
		"@graphql-codegen/typescript": "4.0.6",
		"@graphql-codegen/typescript-operations": "4.2.0",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@playwright/test": "1.42.1",
		"@testing-library/svelte": "4.1.0",
		"@types/d3-format": "3.0.4",
		"@types/d3-scale": "4.0.8",
		"@types/d3-shape": "3.1.6",
		"@typescript-eslint/eslint-plugin": "7.5.0",
		"@typescript-eslint/parser": "7.5.0",
		"eslint": "8.57.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.35.1",
		"playwright-core": "1.42.1",
		"prettier": "3.2.5",
		"prettier-plugin-svelte": "3.2.2",
		"svelte-check": "3.6.9",
		"svelte-eslint-parser": "0.33.1",
		"typescript": "5.4.3"
	},
	"type": "module",
	"packageManager": "pnpm@8.15.6"
}
