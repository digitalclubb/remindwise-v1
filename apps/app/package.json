{
	"name": "app",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"build:lambdas": "pnpm run build:notifier && pnpm run build:user-retriever",
		"build:notifier": "esbuild src/lambdas/notifier/index.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=../../dist/notifier/index.js",
		"build:user-retriever": "esbuild src/lambdas/user-retriever/index.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=../../dist/user-retriever/index.js",
		"package": "vite package",
		"prepare": "svelte-kit sync",
		"preview": "vite preview --port 4174",
		"houdini:sync": "houdini generate -p",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../eslint.config.mjs --max-warnings 0",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"graphql:codegen": "pnpm sync && graphql-codegen --require dotenv/config",
		"test": "vitest run",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional",
		"test:visual": "playwright test --grep @visual",
		"test:visual:update": "playwright test --grep @visual --update-snapshots"
	},
	"dependencies": {
		"@aptabase/web": "0.4.3",
		"@aws-sdk/client-dynamodb": "3.682.0",
		"@aws-sdk/client-ses": "3.682.0",
		"@aws-sdk/lib-dynamodb": "3.685.0",
		"@date-fns/utc": "2.1.0",
		"@sentry/sveltekit": "^8.33.1",
		"@supabase/ssr": "0.5.1",
		"@supabase/supabase-js": "2.46.1",
		"@sveltejs/adapter-vercel": "5.4.6",
		"@sveltejs/kit": "2.7.5",
		"@sveltejs/vite-plugin-svelte": "4.0.0",
		"d3-format": "3.1.0",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"date-fns": "4.1.0",
		"houdini": "1.3.0",
		"houdini-svelte": "2.0.0",
		"layercake": "8.4.2",
		"svelte": "5.1.9",
		"svelte-preprocess": "6.0.3",
		"sveltekit-superforms": "2.20.0",
		"vite": "5.4.10",
		"vite-plugin-graphql-loader": "4.0.4",
		"zod": "3.23.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.10.0",
		"@graphql-codegen/cli": "5.0.3",
		"@graphql-codegen/typed-document-node": "5.0.11",
		"@graphql-codegen/typescript": "4.1.1",
		"@graphql-codegen/typescript-operations": "4.3.1",
		"@graphql-typed-document-node/core": "3.2.0",
		"@playwright/test": "1.48.2",
		"@testing-library/svelte": "5.2.4",
		"@types/aws-lambda": "8.10.145",
		"@types/d3-format": "3.0.4",
		"@types/d3-scale": "4.0.8",
		"@types/d3-shape": "3.1.6",
		"@types/node": "22.9.0",
		"@typescript-eslint/eslint-plugin": "8.13.0",
		"@typescript-eslint/parser": "8.13.0",
		"dotenv": "16.4.5",
		"esbuild": "0.24.0",
		"eslint": "9.14.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.46.0",
		"jsdom": "^25.0.1",
		"msw": "2.6.0",
		"prettier": "3.3.3",
		"prettier-plugin-svelte": "3.2.7",
		"svelte-check": "4.0.5",
		"svelte-eslint-parser": "0.43.0",
		"typescript": "5.6.3",
		"typescript-eslint": "8.13.0",
		"vitest": "2.1.4"
	},
	"type": "module",
	"packageManager": "pnpm@9.12.3",
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
