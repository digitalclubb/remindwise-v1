{
	"name": "app",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"package": "vite package",
		"prepare": "svelte-kit sync",
		"preview": "vite preview --port 4174",
		"houdini:sync": "houdini generate -p",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../eslint.config.mjs --max-warnings 0",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"graphql:codegen": "pnpm sync && graphql-codegen --require dotenv/config",
		"test": "vitest run",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional",
		"test:visual": "playwright test --grep @visual",
		"test:visual:update": "playwright test --grep @visual --update-snapshots"
	},
	"dependencies": {
		"@aptabase/web": "0.4.3",
		"@aws-sdk/client-dynamodb": "3.651.1",
		"@aws-sdk/client-ses": "3.651.1",
		"@aws-sdk/lib-dynamodb": "3.651.1",
		"@supabase/ssr": "0.5.1",
		"@supabase/supabase-js": "2.45.2",
		"@sveltejs/adapter-vercel": "5.4.3",
		"@sveltejs/kit": "2.5.25",
		"@sveltejs/vite-plugin-svelte": "3.1.2",
		"d3-format": "3.1.0",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"date-fns": "4.0.0-beta.1",
		"houdini": "1.2.56",
		"houdini-svelte": "1.2.56",
		"layercake": "8.3.4",
		"svelte": "4.2.19",
		"svelte-preprocess": "6.0.2",
		"sveltekit-superforms": "2.17.0",
		"vite": "5.4.2",
		"vite-plugin-graphql-loader": "4.0.4",
		"zod": "3.23.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.10.0",
		"@graphql-codegen/cli": "5.0.2",
		"@graphql-codegen/typed-document-node": "5.0.9",
		"@graphql-codegen/typescript": "4.0.9",
		"@graphql-codegen/typescript-operations": "4.2.3",
		"@graphql-typed-document-node/core": "3.2.0",
		"@playwright/test": "1.46.1",
		"@testing-library/svelte": "4.2.3",
		"@types/aws-lambda": "8.10.145",
		"@types/d3-format": "3.0.4",
		"@types/d3-scale": "4.0.8",
		"@types/d3-shape": "3.1.6",
		"@types/node": "20.16.2",
		"@typescript-eslint/eslint-plugin": "8.3.0",
		"@typescript-eslint/parser": "8.3.0",
		"dotenv": "16.4.5",
		"eslint": "9.9.1",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.43.0",
		"msw": "2.4.0",
		"prettier": "3.3.3",
		"prettier-plugin-svelte": "3.2.6",
		"svelte-check": "3.8.6",
		"svelte-eslint-parser": "0.41.0",
		"typescript": "5.5.4",
		"typescript-eslint": "8.3.0",
		"vitest": "2.0.5"
	},
	"type": "module",
	"packageManager": "pnpm@9.9.0",
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
