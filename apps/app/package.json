{
	"name": "app",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"build:lambdas": "pnpm run build:notifier && pnpm run build:user-retriever",
		"build:notifier": "esbuild src/lambdas/notifier/index.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=../../dist/notifier/index.js",
		"build:user-retriever": "esbuild src/lambdas/user-retriever/index.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=../../dist/user-retriever/index.js",
		"package": "vite package",
		"prepare": "svelte-kit sync",
		"preview": "vite preview --port 4174",
		"houdini:sync": "houdini generate -p",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../eslint.config.mjs --max-warnings 0",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"graphql:codegen": "pnpm sync && graphql-codegen --require dotenv/config",
		"test": "vitest run",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional",
		"test:visual": "playwright test --grep @visual",
		"test:visual:update": "playwright test --grep @visual --update-snapshots"
	},
	"dependencies": {
		"@aptabase/web": "0.4.3",
		"@aws-sdk/client-dynamodb": "3.658.1",
		"@aws-sdk/client-ses": "3.658.1",
		"@aws-sdk/lib-dynamodb": "3.658.1",
		"@supabase/ssr": "0.5.1",
		"@supabase/supabase-js": "2.45.4",
		"@sveltejs/adapter-vercel": "5.4.4",
		"@sveltejs/kit": "2.6.0",
		"@sveltejs/vite-plugin-svelte": "3.1.2",
		"d3-format": "3.1.0",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"date-fns": "4.1.0",
		"houdini": "1.2.62",
		"houdini-svelte": "1.2.62",
		"layercake": "8.3.4",
		"svelte": "4.2.19",
		"svelte-preprocess": "6.0.3",
		"sveltekit-superforms": "2.19.0",
		"vite": "5.4.8",
		"vite-plugin-graphql-loader": "4.0.4",
		"zod": "3.23.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.10.0",
		"@graphql-codegen/cli": "5.0.2",
		"@graphql-codegen/typed-document-node": "5.0.9",
		"@graphql-codegen/typescript": "4.0.9",
		"@graphql-codegen/typescript-operations": "4.2.3",
		"@graphql-typed-document-node/core": "3.2.0",
		"@playwright/test": "1.47.2",
		"@testing-library/svelte": "4.2.3",
		"@types/aws-lambda": "8.10.145",
		"@types/d3-format": "3.0.4",
		"@types/d3-scale": "4.0.8",
		"@types/d3-shape": "3.1.6",
		"@types/node": "20.16.9",
		"@typescript-eslint/eslint-plugin": "8.7.0",
		"@typescript-eslint/parser": "8.7.0",
		"dotenv": "16.4.5",
		"esbuild": "0.24.0",
		"eslint": "9.11.1",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.44.1",
		"msw": "2.4.9",
		"prettier": "3.3.3",
		"prettier-plugin-svelte": "3.2.7",
		"svelte-check": "4.0.3",
		"svelte-eslint-parser": "0.41.1",
		"typescript": "5.6.2",
		"typescript-eslint": "8.7.0",
		"vitest": "2.1.1"
	},
	"type": "module",
	"packageManager": "pnpm@9.11.0",
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
