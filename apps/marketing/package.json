{
	"name": "marketing",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3001",
		"build": "vite build",
		"prepare": "svelte-kit sync",
		"preview": "vite preview --port 4173",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../eslint.config.mjs",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional",
		"test:visual": "playwright test --grep @visual",
		"test:visual:update": "playwright test --grep @visual --update-snapshots"
	},
	"dependencies": {
		"@aptabase/web": "0.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.10.0",
		"@playwright/test": "1.48.2",
		"@sveltejs/adapter-vercel": "5.4.6",
		"@sveltejs/kit": "2.7.4",
		"@sveltejs/vite-plugin-svelte": "4.0.0",
		"@typescript-eslint/eslint-plugin": "8.12.2",
		"@typescript-eslint/parser": "8.12.2",
		"eslint": "9.14.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.46.0",
		"prettier": "3.3.3",
		"prettier-plugin-svelte": "3.2.7",
		"svelte": "5.1.9",
		"svelte-check": "4.0.5",
		"svelte-eslint-parser": "0.43.0",
		"svelte-preprocess": "6.0.3",
		"typescript": "5.6.3",
		"typescript-eslint": "8.12.2",
		"vite": "5.4.10"
	},
	"type": "module"
}
