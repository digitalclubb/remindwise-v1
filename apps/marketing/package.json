{
	"name": "marketing",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3001",
		"build": "vite build",
		"preview": "vite preview --port 4173",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../.eslintrc.js 'src'",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional"
	},
	"dependencies": {
		"@vercel/analytics": "1.1.1",
		"components": "workspace:*",
		"svelte-cloudinary": "1.1.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.8.3",
		"@playwright/test": "1.41.0",
		"@sveltejs/adapter-vercel": "4.0.5",
		"@sveltejs/kit": "2.3.3",
		"@sveltejs/vite-plugin-svelte": "3.0.1",
		"@typescript-eslint/eslint-plugin": "6.19.0",
		"@typescript-eslint/parser": "6.19.0",
		"eslint": "8.56.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.35.1",
		"playwright-core": "1.41.0",
		"prettier": "3.2.3",
		"prettier-plugin-svelte": "3.1.2",
		"svelte": "4.2.8",
		"svelte-check": "3.6.3",
		"svelte-eslint-parser": "0.33.1",
		"svelte-preprocess": "5.1.3",
		"typescript": "5.3.3",
		"vite": "5.0.11"
	},
	"type": "module"
}
