{
	"name": "marketing",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3001",
		"build": "vite build",
		"prepare": "svelte-kit sync",
		"preview": "vite preview --port 4173",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../eslint.config.mjs",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional",
		"test:visual": "playwright test --grep @visual",
		"test:visual:update": "playwright test --grep @visual --update-snapshots"
	},
	"dependencies": {
		"@aptabase/web": "0.4.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.9.1",
		"@playwright/test": "1.45.1",
		"@sveltejs/adapter-vercel": "5.4.1",
		"@sveltejs/kit": "2.5.18",
		"@sveltejs/vite-plugin-svelte": "3.1.1",
		"@typescript-eslint/eslint-plugin": "7.16.0",
		"@typescript-eslint/parser": "7.16.0",
		"eslint": "9.6.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.41.0",
		"prettier": "3.3.2",
		"prettier-plugin-svelte": "3.2.5",
		"svelte": "4.2.18",
		"svelte-check": "3.8.4",
		"svelte-eslint-parser": "0.39.2",
		"svelte-preprocess": "6.0.2",
		"typescript": "5.5.3",
		"typescript-eslint": "7.16.0",
		"vite": "5.3.3"
	},
	"type": "module"
}
