{
	"name": "marketing",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3001",
		"build": "vite build",
		"preview": "vite preview --port 4173",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../.eslintrc.js 'src'",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional"
	},
	"dependencies": {
		"@vercel/analytics": "^1.1.1",
		"components": "workspace:*",
		"svelte-cloudinary": "^1.1.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.8.2",
		"@playwright/test": "1.40.1",
		"@sveltejs/adapter-vercel": "4.0.1",
		"@sveltejs/kit": "2.0.0",
		"@testing-library/svelte": "4.0.5",
		"svelte": "4.2.8",
		"svelte-check": "3.6.2",
		"svelte-preprocess": "5.1.2",
		"tslib": "2.6.2",
		"typescript": "5.3.3",
		"vite": "5.0.9",
		"vitest": "1.0.4"
	},
	"type": "module"
}
