{
	"name": "marketing",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3001",
		"build": "vite build",
		"preview": "vite preview --port 4173",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../eslint.config.mjs",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional"
	},
	"dependencies": {
		"@vercel/analytics": "1.3.0",
		"components": "workspace:*",
		"svelte-cloudinary": "1.3.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.9.1",
		"@playwright/test": "1.44.1",
		"@sveltejs/adapter-vercel": "5.3.0",
		"@sveltejs/kit": "2.5.10",
		"@sveltejs/vite-plugin-svelte": "3.1.0",
		"@typescript-eslint/eslint-plugin": "7.10.0",
		"@typescript-eslint/parser": "7.10.0",
		"eslint": "9.3.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.39.0",
		"playwright-core": "1.44.1",
		"prettier": "3.2.5",
		"prettier-plugin-svelte": "3.2.3",
		"svelte": "4.2.17",
		"svelte-check": "3.7.1",
		"svelte-eslint-parser": "0.36.0",
		"svelte-preprocess": "5.1.4",
		"typescript": "5.4.5",
		"typescript-eslint": "7.10.0",
		"vite": "5.2.11"
	},
	"type": "module"
}
