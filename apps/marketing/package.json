{
	"name": "marketing",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev --port 3001",
		"build": "vite build",
		"preview": "vite preview --port 4173",
		"types": "svelte-check --tsconfig ./tsconfig.json",
		"types:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --config ../../eslint.config.mjs",
		"format": "prettier --check --ignore-path=../../.prettierignore .",
		"format:write": "prettier --write --ignore-path=../../.prettierignore .",
		"test:a11y": "playwright test --grep @accessibility",
		"test:functional": "playwright test --grep @functional"
	},
	"dependencies": {
		"@aptabase/web": "0.4.2",
		"components": "workspace:*"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.9.1",
		"@playwright/test": "1.44.1",
		"@sveltejs/adapter-vercel": "5.3.2",
		"@sveltejs/kit": "2.5.16",
		"@sveltejs/vite-plugin-svelte": "3.1.1",
		"@typescript-eslint/eslint-plugin": "7.13.0",
		"@typescript-eslint/parser": "7.13.0",
		"eslint": "9.5.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.39.4",
		"prettier": "3.3.2",
		"prettier-plugin-svelte": "3.2.4",
		"svelte": "4.2.18",
		"svelte-check": "3.8.0",
		"svelte-eslint-parser": "0.38.0",
		"svelte-preprocess": "6.0.1",
		"typescript": "5.4.5",
		"typescript-eslint": "7.13.0",
		"vite": "5.3.1"
	},
	"type": "module"
}
