{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".svelte-kit/**", ".vercel/**"]
		},
		"preview": {
			"dependsOn": ["^build"]
		},
		"test": {},
		"format": {},
		"format:write": {},
		"lint": {
			"outputs": []
		},
		"types": {},
		"test:watch": {
			"cache": false
		},
		"test:a11y": {},
		"test:functional": {},
		"dev": {
			"cache": false
		}
	},
	"globalDependencies": ["**/pnpm-lock.yaml"]
}
